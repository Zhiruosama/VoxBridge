{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "subtitle",
  "description": "Read-only local subtitle window with stop and recovery controls",
  "windows": ["subtitle"],
  "permissions": [
    "allow-record-diagnostic", "core:event:allow-listen", "core:event:allow-unlisten", "allow-drag-overlay", "allow-resize-overlay", "allow-set-overlay-text-input",
    "allow-read-overlay", "allow-read-overlay-voice", "allow-overlay-voice-action", "allow-focus-main", "allow-stop-overlay-listening"
  ]
}
