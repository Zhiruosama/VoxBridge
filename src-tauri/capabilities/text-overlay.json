{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "text-overlay",
  "description": "Text result display only; no direct clipboard, provider or credential access",
  "windows": [
    "text-overlay"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-read-text-overlay",
    "allow-text-overlay-action",
    "allow-hide-text-overlay",
    "allow-focus-main",
    "allow-drag-overlay",
    "allow-resize-overlay"
  ]
}
