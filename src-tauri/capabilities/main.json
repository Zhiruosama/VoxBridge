{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Local workspace window only",
  "windows": ["main"],
  "permissions": [
    "allow-prepare-speech", "allow-play-prepared-speech", "allow-discard-prepared-speech",
    "allow-virtual-mic-status", "allow-open-virtual-mic-vendor",
    "allow-record-diagnostic", "allow-open-diagnostics-folder", "allow-export-diagnostics",
    "core:default", "allow-list-inputs", "allow-start-voice-input", "allow-finish-voice-input", "allow-cancel-voice-input", "allow-runtime-info", "allow-credential-status", "allow-set-credential",
    "allow-remove-credential", "allow-translate",
    "allow-detect-text-language", "allow-cancel-translation", "allow-transcribe-wav",
    "allow-stop-asr", "allow-list-outputs", "allow-test-tone", "allow-stop-tone",
    "allow-list-capture-sources", "allow-capture-diagnostic", "allow-stop-capture", "allow-finish-listening", "allow-start-listening",
    "allow-speak", "allow-stop-speech", "allow-set-speech-monitoring", "allow-open-virtual-mic-installer", "allow-publish-overlay", "allow-read-overlay", "allow-read-overlay-voice", "allow-publish-overlay-voice",
    "allow-show-overlay", "allow-hide-overlay", "allow-focus-main", "allow-stop-overlay-listening"
  ]
}
