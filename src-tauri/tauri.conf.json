{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VoxBridge",
  "version": "0.4.1",
  "identifier": "com.voxbridge.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build && node scripts/build-desktop-resources.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "VoxBridge",
        "create": false,
        "backgroundColor": "#1e1e1e",
        "width": 1180,
        "height": 820,
        "minWidth": 1000,
        "minHeight": 560
      },
      {
        "label": "subtitle",
        "create": false,
        "title": "VoxBridge 字幕",
        "url": "index.html?window=subtitle",
        "width": 760,
        "height": 320,
        "minWidth": 480,
        "minHeight": 220,
        "visible": false,
        "focus": false,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "transparent": true,
        "decorations": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": "all",
    "macOS": {
      "minimumSystemVersion": "14.2",
      "infoPlist": "Info.plist",
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM1MTU2RjUxODIxQ0MzMkQKUldRdHd4eUNVVzhWTmF5SEZSLzNnZEE1Q1ZBeFZ5SmlGUzB0YlNqblNsclBOeklpczE1cXRkaE4K",
      "endpoints": [
        "https://raw.githubusercontent.com/Zhiruosama/VoxBridge/update-feed/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      },
      "requireSignedVersion": true
    }
  }
}
