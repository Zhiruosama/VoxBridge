{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "resources": {
      "../native/windows/.build/VBCABLE_Driver_Pack45/": "virtual-microphone/vb-cable/",
      "../native/windows/Audio-Defaults.cs": "virtual-microphone/Audio-Defaults.cs",
      "../native/windows/Manage-Virtual-Microphone.ps1": "virtual-microphone/Manage-Virtual-Microphone.ps1",
      "../native/windows/vb-cable-manifest.json": "virtual-microphone/vb-cable-manifest.json"
    },
    "windows": {
      "nsis": {
        "installerHooks": "../native/windows/installer-hooks.nsh",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "../native/windows/installer-artwork/header.bmp",
        "sidebarImage": "../native/windows/installer-artwork/sidebar.bmp",
        "startMenuFolder": "VoxBridge",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": false
      }
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "VoxBridge",
        "create": false,
        "backgroundColor": "#1e1e1e",
        "width": 1062,
        "height": 738,
        "minWidth": 1000,
        "minHeight": 560
      },
      {
        "label": "subtitle",
        "create": false,
        "title": "VoxBridge 字幕",
        "url": "index.html?window=subtitle",
        "width": 760,
        "height": 320,
        "minWidth": 480,
        "minHeight": 220,
        "visible": false,
        "focus": false,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "transparent": true,
        "decorations": false,
        "skipTaskbar": true
      },
      {
        "label": "text-overlay",
        "create": false,
        "title": "VoxBridge 文本翻译",
        "url": "index.html?window=text-overlay",
        "width": 560,
        "height": 300,
        "minWidth": 360,
        "minHeight": 180,
        "visible": false,
        "focus": false,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "transparent": true,
        "decorations": false,
        "skipTaskbar": true
      }
    ]
  }
}
